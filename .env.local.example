# Copie este arquivo para .env.local e preencha com os dados reais.

# Supabase — Project Settings > API no dashboard do seu projeto
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Supabase — Project Settings > API > service_role (secreta! nunca exponha
# no navegador — só é usada no webhook do Stripe, em código de servidor)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Stripe — dashboard.stripe.com/apikeys (use as chaves de TESTE pra
# desenvolver: começam com sk_test_ e pk_test_)
STRIPE_SECRET_KEY=sk_test_...

# Stripe — crie dois produtos recorrentes em dashboard.stripe.com/products
# (um pro plano do cliente, outro pro plano do personal trainer) e cole o
# ID do preço (começa com price_...) de cada um aqui
STRIPE_PRICE_CLIENT=price_...
STRIPE_PRICE_TRAINER=price_...

# Stripe — segredo do webhook. Em desenvolvimento local, rode
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (Stripe
# CLI) e cole o "whsec_..." que ele mostrar. Em produção, crie o endpoint
# em dashboard.stripe.com/webhooks e cole o segredo de lá.
STRIPE_WEBHOOK_SECRET=whsec_...

# URL do seu site (usada nos redirects do Checkout/Portal do Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Capacitor (app Android) — URL do site já publicado (ex: Vercel).
# Só usada localmente ao rodar `npx cap sync`, não precisa estar na Vercel.
CAPACITOR_SERVER_URL=https://seu-site-publicado.vercel.app
